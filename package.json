{
  "name": "dsh-sentinel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./task-notify.mjs",
    "./client": "./client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    },
    "manifestVersion": 1
  },
  "description": "Looks after DeepSeek Harness from outside its main process: task completion notifications and a tray launcher.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/herenfor/dsh-sentinel.git"
  },
  "homepage": "https://github.com/herenfor/dsh-sentinel#readme",
  "bugs": {
    "url": "https://github.com/herenfor/dsh-sentinel/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "notifications",
    "windows",
    "wsl"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "scripts": {
    "test": "node --test"
  },
  "files": [
    "task-notify.mjs",
    "attention.mjs",
    "background-jobs.mjs",
    "notification-channel.mjs",
    "client.js",
    "notification-worker.js",
    "notify-windows.sh",
    "notify-windows.ps1",
    "notify-windows-pwsh.ps1",
    "notification-content.ps1",
    "notification-identity.ps1",
    "tray/dsh-tray-host.sh",
    "tray/dsh-tray.ps1",
    "tray/start-dsh-tray.vbs",
    "tray/install.sh",
    "tray/create-shortcut.ps1",
    "whale.svg",
    "whale.png",
    "whale.ico",
    "cordis.patch.yml",
    "THIRD_PARTY_NOTICES.md",
    "README.en.md",
    "DEVELOPING.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "license": "MIT"
}
